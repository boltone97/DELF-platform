# Copiez ce fichier en .env.local et remplissez avec les valeurs de
# Supabase → Project Settings → API (Project URL + clé « anon / publishable »).
# Sans ces variables, l'app tourne en « mode démo local » (données dans le navigateur).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
